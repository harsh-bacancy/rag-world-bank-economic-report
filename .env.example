# ---- Gemini (free tier) ---------------------------------------------------------
# https://aistudio.google.com/apikey — without it the app still routes and retrieves (keyword channel), but writes no answers.
GOOGLE_GENERATIVE_AI_API_KEY=
# On a new free-tier key the lite models carry the usable quota (500 requests/day per model).
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# One limiter per project. If the sibling RAG projects share this key, run only one Gemini-consuming process at a time.
GEMINI_RPM=10
GEMINI_RPD=1500

# ---- Store ------------------------------------------------------------------------
# local (default): the JSON index in data/index, zero setup.  supabase: Postgres + pgvector (run supabase/migrations/0001_init.sql, then npm run db:push)
STORE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Retrieval ----------------------------------------------------------------------
# Refuse without a model call when the best reranked passage scores below this (calibrated by npm run eval:retrieval).
RERANK_REFUSAL_THRESHOLD=0.15
# Set to 1 once to let the reranker download its weights if .cache/models is empty.
RERANKER_ALLOW_REMOTE=0
